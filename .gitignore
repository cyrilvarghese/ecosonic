# Audio library — 5.8 GB of raw samples, never commit
ECOSONIC FILES/

# Runtime analysis cache (saved reference-track analyses)
config/analyses.json

# Dependencies
node_modules/

# Next.js
.next/
out/
build/
dist/

# TypeScript build cache
*.tsbuildinfo

# Generated
# NOTE: src/manifest.json is deliberately NOT ignored. It is generated by
# `npm run build:manifest`, but it is also statically imported by appStore.ts — and it cannot be
# regenerated on Vercel, which has no copy of the 5.9 GB library. Committed, the hosted build works;
# ignored, it fails on a missing module. Re-run build:manifest and commit when samples change.

# Env / secrets
.env
.env.local
.env*.local

# OS / editor cruft
.DS_Store
._*
Thumbs.db
*.log
.vscode/
.idea/

# Agent worktrees — each is its own checkout, and `git add -A` would commit them
# as gitlinks pointing at commits no clone can resolve.
.claude/worktrees/

# SDD scratch
.superpowers/
